{
  "name": "stockwell",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "test": "node tests/run.cjs",
    "test:seo": "node scripts/seo-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:import-sqlite": "tsx scripts/import-sqlite.ts",
    "test:integration": "node --import tsx --test tests/workspace.test.ts tests/workspace-p1.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@neon/config": "^1.8.4",
    "@neon/env": "^1.5.1",
    "@opennextjs/cloudflare": "^1.20.9",
    "@vercel/analytics": "1.6.1",
    "@vercel/functions": "^3.9.11",
    "better-auth": "^1.7.7",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "kysely": "^0.29.6",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "pg": "^8.23.1",
    "pg-cloudflare": "^1.4.1",
    "react": "^19",
    "react-dom": "^19",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxlint": "^1.87.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.7.3",
    "wrangler": "^4.151.0"
  }
}
