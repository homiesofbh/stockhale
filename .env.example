# Neon pooled connection string (-pooler host), with SSL parameters from Neon.
# For local PostgreSQL, use postgresql://user:password@localhost:5432/stockwell.
DATABASE_URL=

# Optional direct Neon connection used only by migration/import scripts.
DATABASE_MIGRATION_URL=

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this value private and stable across deployments.
BETTER_AUTH_SECRET=
# Use the exact origin for each deployment; no wildcard preview origins.
BETTER_AUTH_URL=https://stockhale.app

# Canonical public origin used to render metadata, robots.txt, sitemap.xml, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://stockhale.app

# Set true to disable public workspace creation; invited team signup remains available.
DISABLE_PUBLIC_SIGNUP=false

# Resend password-reset and optional activity-email delivery. The sender must use a Resend-verified domain. Never use NEXT_PUBLIC_ for secrets.
RESEND_API_KEY=
RESEND_FROM=Stockwell <alerts@your-verified-domain.com>
