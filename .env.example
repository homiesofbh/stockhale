# Node 24+, one persistent server. Keep this directory on a persistent volume.
STOCKWELL_DATA_DIR=.stockwell
# Resend API key and a verified domain sender. Never use NEXT_PUBLIC_ for secrets.
RESEND_API_KEY=
RESEND_FROM=Stockwell <alerts@your-verified-domain.com>

# Optional canonical HTTPS origin behind a reverse proxy
# STOCKWELL_ORIGIN=https://stockwell.example.com
